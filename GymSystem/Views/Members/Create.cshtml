
@model CreateMemberViewModel
@{
    ViewData["Title"] = "Create Member";
}

<div class="container">
    <main role="main" class="pb-3">

        <header class="mb-4">
            <h3 class="text-primary">Add Member</h3>
        </header>

        <form asp-action="CreateMember" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="addMemberTabs" role="tablist">

                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            id="member-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#member-info"
                            type="button">
                        Member Info
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="health-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#health-info"
                            type="button">
                        Health Data
                    </button>
                </li>

            </ul>

            <div class="tab-content">

                <!-- Member Information -->
                <div class="tab-pane fade show active"
                     id="member-info"
                     role="tabpanel">

                    <div class="section-header mb-3">
                        <h5 class="text-primary fw-bold">
                            Personal Information
                        </h5>
                        <hr />
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender"
                                    asp-items="Html.GetEnumSelectList<Gender>()"
                                    class="form-select">
                                <option value="">-- Select Gender --</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="section-header mb-3 mt-4">
                        <h5 class="text-primary fw-bold">
                            Address Information
                        </h5>
                        <hr />
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="BuildingNumber" class="form-label"></label>
                            <input asp-for="BuildingNumber" class="form-control" />
                            <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                    </div>

                </div>

                <!-- Health Data -->
                <div class="tab-pane fade"
                     id="health-info"
                     role="tabpanel">

                    <div class="section-header mb-3">
                        <h5 class="text-primary fw-bold">
                            Health Information
                        </h5>
                        <hr />
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="HealthRecordViewModel.Height"
                                   class="form-label"></label>

                            <input asp-for="HealthRecordViewModel.Height"
                                   class="form-control" />

                            <span asp-validation-for="HealthRecordViewModel.Height"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HealthRecordViewModel.Weight"
                                   class="form-label"></label>

                            <input asp-for="HealthRecordViewModel.Weight"
                                   class="form-control" />

                            <span asp-validation-for="HealthRecordViewModel.Weight"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HealthRecordViewModel.BloodType"
                                   class="form-label"></label>

                            <select asp-for="HealthRecordViewModel.BloodType"
                                    class="form-select">
                                <option value="">Select Blood Type</option>
                                <option>A+</option>
                                <option>A-</option>
                                <option>B+</option>
                                <option>B-</option>
                                <option>O+</option>
                                <option>O-</option>
                                <option>AB+</option>
                                <option>AB-</option>
                            </select>

                            <span asp-validation-for="HealthRecordViewModel.BloodType"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HealthRecordViewModel.Note"
                                   class="form-label"></label>

                            <input asp-for="HealthRecordViewModel.Note"
                                   class="form-control" />

                            <span asp-validation-for="HealthRecordViewModel.Note"
                                  class="text-danger"></span>
                        </div>

                    </div>

                </div>

            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">

                <a asp-controller="Members"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back To List
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Add Member
                </button>

            </div>

        </form>

    </main>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
